# SearXNG MCP Server Configuration

# URL of the SearXNG instance to use.
# This is the only required configuration.
# Default: https://search-4.xlion.dev
SEARXNG_URL=https://search-4.xlion.dev

# Enable verbose HTTP request/response logging for debugging.
# Set to "1" to enable debug logging (same as --debug CLI flag).
# Default: (not set — debug logging disabled)
# DEBUG=1
