# SearXNG MCP Server Configuration

# URL of the SearXNG instance to use.
# This is required — no default value. Use your own SearXNG instance.
SEARXNG_URL=http://localhost:8888

# Enable verbose HTTP request/response logging for debugging.
# Set to "1" to enable debug logging (same as --debug CLI flag).
# Default: (not set — debug logging disabled)
# DEBUG=1

# HTTP client timeout for SearXNG requests (Go duration format, e.g. "8s", "30s").
# Default: 8s
# SEARXNG_TIMEOUT=30s

# Maximum number of retries after the initial search attempt.
# Default: 5
# SEARXNG_MAX_RETRIES=2

# Opt in to GET fallback when the SearXNG instance rejects POST /search
# with 405/501. Disabled by default — GET sends search parameters in the URL.
# SEARXNG_ALLOW_GET_FALLBACK=1
